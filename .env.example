# Server-only Stripe credentials. Use a sandbox key locally and on Vercel Preview.
# Obtain values from the matching Stripe account/environment; never commit them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Exact browser origin: https://<preview-domain> on Vercel, localhost for test keys.
NUVOLA_SITE_URL=http://localhost:3000

# Comma-separated slugs with prices, inventory and options verified by Nuvola.
# Empty keeps purchasing disabled. Beds remain showroom-only (no size selector).
NUVOLA_APPROVED_PRODUCT_SLUGS=

# Required only for live keys, on a production server. Keep false during testing.
STRIPE_LIVE_CHECKOUT_ENABLED=false
