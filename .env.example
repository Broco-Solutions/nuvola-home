# The only required application environment variable. Never use NEXT_PUBLIC_.
# Production: live key. Local/Vercel Preview: test key only.
STRIPE_SECRET_KEY=

# Optional: signing secret from the matching Stripe webhook endpoint.
# Leaving it empty does not prevent card checkout or API payment verification.
STRIPE_WEBHOOK_SECRET=

# Production URLs use https://www.nuvola-home.com. Test previews use Vercel's
# automatic deployment URLs; local development uses the loopback request URL.
# Product authorization and approved USD prices live in src/config/commerce.ts.
# Stripe Tax remains enabled and must be configured in Stripe Dashboard.
